<Window x:Class="Titanium.Desktop.Views.WorkspaceSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Workspace Settings" Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="#CCCCCC" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="WORKSPACE SETTINGS" FontSize="14" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,4"/>
            <TextBlock Text="Configure workspace metadata and Microsoft 365 folder synchronization filters." FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Form Controls -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Workspace Name" FontWeight="SemiBold" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
            <TextBox x:Name="WorkspaceNameTextBox" Background="#252526" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="6" Margin="0,0,0,12"/>

            <TextBlock Text="Description" FontWeight="SemiBold" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
            <TextBox x:Name="WorkspaceDescriptionTextBox" Background="#252526" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="6" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12"/>

            <TextBlock Text="Email Sync Folders" FontWeight="SemiBold" FontSize="11" Foreground="#4EC9B0" Margin="0,0,0,4"/>
            <TextBlock Text="Specify folders to pull communications from (comma or semicolon separated, e.g. 'Inbox, Family\Separation, Legal'):" FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBox x:Name="TargetFoldersTextBox" Background="#252526" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="6" Margin="0,0,0,16"/>
        </StackPanel>

        <!-- Dialog Buttons -->
        <DockPanel Grid.Row="2">
            <Button Content="Delete Workspace" Click="DeleteButton_Click" Background="#4A1818" Foreground="#FF9999" BorderBrush="#662222" Padding="12,6" HorizontalAlignment="Left" ToolTip="Permanently remove this workspace and its associated data"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Click="SaveButton_Click" Background="#0E639C" Foreground="White" Padding="16,6" Margin="0,0,8,0" BorderThickness="0" IsDefault="True"/>
                <Button Content="Cancel" Click="CancelButton_Click" Background="#3F3F46" Foreground="White" Padding="16,6" BorderThickness="0" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
